# Nucleus — Apache Rewrite Rules
# The Missing Dashboard for Linux Developers
# Serves the dashboard at root, project subdirs directly

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Route Next.js assets & routes for 2tinteractive when requested from root domain
    RewriteRule ^_next/(.*)$ 2tinteractive/out/_next/$1 [L]
    RewriteRule ^assets/droids/(.*)$ 2tinteractive/out/assets/droids/$1 [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^branding/(.*)$ 2tinteractive/out/branding/$1 [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ai/(.*)$ 2tinteractive/out/ai/$1 [L]
    # Next.js clean URLs for solutions routes
    RewriteCond %{DOCUMENT_ROOT}/2tinteractive/out/solutions/$1.html -f
    RewriteRule ^solutions/([^/]+)/?$ 2tinteractive/out/solutions/$1.html [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^solutions/(.*)$ 2tinteractive/out/solutions/$1 [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{DOCUMENT_ROOT}/2tinteractive/out/$1 -f
    RewriteRule ^(.*\.txt)$ 2tinteractive/out/$1 [L]

    # Redirect /favicon.ico to actual location
    RewriteRule ^favicon\.ico$ /assets/images/favicon/favicon.ico [L,R=301]

    # Serve existing files directly (CSS, JS, images, etc.)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Redirect /project/public/ to /project/out/ if out/index.html exists
    RewriteCond %{REQUEST_URI} ^/([^/]+)/public/?$
    RewriteCond %{DOCUMENT_ROOT}/%1/out/index.html -f
    RewriteRule ^([^/]+)/public/?$ /$1/out/ [L,R=301]

    # For Next.js static export project dirs with an out/ folder, redirect to out/
    RewriteCond %{REQUEST_URI} ^/([^/]+)/?$
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{DOCUMENT_ROOT}/%1/out/index.html -f
    RewriteRule ^([^/]+)/?$ /$1/out/ [L,R=301]

    # For project dirs with a public/ folder (Laravel, etc.), redirect to public/
    RewriteCond %{REQUEST_URI} ^/([^/]+)/?$
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{DOCUMENT_ROOT}/%1/out/index.html !-f
    RewriteCond %{DOCUMENT_ROOT}/%1/public -d
    RewriteCond %1 !^(assets|build|includes|partials|pages|api|i18n|cache|data|logs|laragon-dashboard|dashboard)$
    RewriteRule ^([^/]+)/?$ /$1/public/ [L,R=301]

    # For Laravel: route non-file requests within public/ to public/index.php
    RewriteCond %{REQUEST_URI} ^/([^/]+)/public/(.*)$
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([^/]+)/public/(.*)$ /$1/public/index.php [L]

    # Serve existing directories directly (dashboard pages, assets, etc.)
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Dashboard routing: everything else goes to index.php?page=X
    RewriteRule ^$ index.php [L]
    RewriteRule ^(.+)$ index.php?page=$1 [QSA,L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Block access to sensitive runtime directories
<IfModule mod_alias.c>
    RedirectMatch 403 ^/(data|cache|logs|uploaded)(/|$)
    RedirectMatch 403 ^/\.git(/|$)

    # Block dotfiles and hidden files, but keep /.well-known for ACME challenges
    RedirectMatch 403 ^/\.(?!well-known/).*$
</IfModule>

# Block access to sensitive file types
<FilesMatch "\.(env|ini|conf|sql|bak|log|lock|md|yml|yaml|gitignore|gitattributes)$">
    Require all denied
</FilesMatch>
